# ==============================================================================
# NYX Security Intelligence Engine — Environment Configuration Template
# ==============================================================================
# Copy or rename this file to .env for local deployment:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file containing live API keys or credentials.
# ==============================================================================

# --- Server & Core Configuration ---
NYX_HOST=0.0.0.0
NYX_PORT=8000
NYX_API_TOKEN=nyx-secret-api-token-change-me
NYX_AUTH_ENABLED=true
NYX_DEBUG=false

# --- AI Provider Configuration (Local-First Default) ---
# Active provider: 'local' (default), 'groq', 'gemini', 'xai', 'openai', or 'anthropic'
NYX_AI_PROVIDER=local
NYX_PREFER_LOCAL=true

# --- Local LLM Settings (Ollama / Llama.cpp / vLLM / Local AI) ---
# Primary model name (supports Ollama tag format)
LOCAL_LLM_MODEL=qwen2.5-coder:7b
# Alternative model alias recognized by NYX
# NYX_LOCAL_MODEL=qwen2.5-coder:7b

# Local server endpoint (Ollama default: http://localhost:11434)
LOCAL_LLM_URL=http://localhost:11434

# Inference timeout in seconds (auto-calibrates based on system load)
LOCAL_LLM_TIMEOUT=120

# Token budget limits
LOCAL_MAX_TOKENS=2048
LOCAL_MAX_TOKENS_ENRICHMENT=1000
LOCAL_MAX_TOKENS_EVIDENCE=800

# --- Optional Cloud AI Providers ---
# Uncomment and supply keys to enable cloud reasoning fallbacks
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=your_gemini_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
